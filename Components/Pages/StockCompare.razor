@page "/stock-compare"

<PageTitle>QUANT STACK | 多檔績效比較</PageTitle>

<div class="dashboard-panel">
    <div class="panel-header">
        <h2 class="panel-title">
            <span class="title-icon">📈</span> 股票資本利得報酬比較
        </h2>
        <p class="panel-subtitle">輸入多檔股票代號，快速對比歷史報酬率走勢</p>
    </div>

    <div class="search-box-container">

        <div class="search-input-group">
            <label class="input-label">
                <span class="label-icon">🏷️</span> 股票代號
            </label>
            <div class="input-wrapper">
                <input type="text"
                       @bind="StockIdsInput"
                       placeholder="例如: 0050, 006208 (以逗號隔開)"
                       class="dark-input" />
            </div>
        </div>
        <div class="search-input-group">
            <label class="input-label">
                <span class="label-icon">📅</span> 報酬區間
            </label>
            <div class="input-wrapper">
                <select @bind="SelectedDays" class="dark-input select-custom">
                    <option value="5">5 天</option>
                    <option value="10">10 天</option>
                    <option value="20">20 天</option>
                    <option value="60">60 天</option>
                    <option value="120">120 天</option>
                    <option value="220">220 天</option>
                </select>
            </div>
        </div>

        <div class="search-input-group adj-group">
            <label class="adj-toggle" title="依除權息資料還原收盤價再算報酬率；需先到「API 資料更新」同步除權除息，未同步的股票不會還原">
                <input type="checkbox" @bind="Adjusted" />
                <span>還原股價</span>
            </label>
        </div>

        <div class="search-action-group">
            <button @onclick="CompareStocks" class="action-btn" disabled="@IsBusy">
                <span class="btn-icon">⚡</span> 開始比較
            </button>
            <button @onclick="UpdateAndCompare" class="action-btn" disabled="@IsBusy" title="先更新這些股票近三個月的日線 (等同日線批次同步)，再比較">
                <span class="btn-icon">🔄</span> 更新並比較
            </button>
            <button @onclick="SaveDefaultIds" class="action-btn secondary" disabled="@IsBusy" title="把目前輸入的股票代號存成預設，下次開啟頁面時自動帶入 (存在這個瀏覽器)">
                <span class="btn-icon">💾</span> 設為預設
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert-box">
            <span class="alert-icon">⚠️</span>
            <span class="alert-text">@Message</span>
        </div>
    }

    <div class="chart-wrapper">
        <div id="compare-chart-container" class="chart-container"></div>
    </div>
</div>
