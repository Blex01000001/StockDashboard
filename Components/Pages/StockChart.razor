@page "/stock-chart"

<PageTitle>QUANT STACK | 技術圖表</PageTitle>

<div class="dashboard-panel panel-standard">
    <div class="panel-header">
        <h2 class="panel-title">📈 K線技術指標圖表</h2>
        <span class="panel-subtitle">本機 SQLite 資料串接</span>
    </div>

    <div class="search-box-container">
        <div class="search-input-wrapper">
            <span class="search-icon">🔍</span>
            <input type="text" @bind="TargetStockId" placeholder="輸入股票代號 (如: 2330)" class="dark-input" />
        </div>
        <button @onclick="LoadChartData" class="action-btn">繪製圖表</button>
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert-box">⚠️ @Message</div>
    }

    <div id="chart-container" style="width: 800px; height: 500px; background-color: #1e222d; margin-top: 20px;"></div>
</div>
