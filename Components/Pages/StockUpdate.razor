@page "/stock-update"

<PageTitle>QUANT STACK | 資料更新</PageTitle>

<div class="dashboard-panel panel-standard">
    <div class="panel-header">
        <h2 class="panel-title">⚙️ API / 手動資料更新面板</h2>
        <span class="panel-subtitle">維護本機 SQLite 資料庫結構 (`StockDailyPrice`)</span>
    </div>

    <div class="update-grid">
        <div class="card-box">
            <h3 class="card-title">🌐 外部 API 批次同步</h3>
            <p class="description">從遠端證券 API 抓取歷史 K 線資料，並使用 <code class="code-tag">INSERT OR REPLACE</code> 覆寫或更新本機 SQLite 資料。</p>

            <div class="form-group">
                <label>更新時間範圍</label>
                <select @bind="SelectedRange" class="dark-input w-100" style="padding-right: 10px;">
                    <option value="1">本月</option>
                    <option value="3">近三個月</option>
                    <option value="12">近一年</option>
                    <option value="36">近三年 (36個月)</option>
                    <option value="60">近五年 (60個月)</option>
                    <option value="120">近十年 (120個月)</option>
                </select>
            </div>

            <div class="form-group">
                <label>指定股票代號</label>
                <div class="search-box-container">
                    <input type="text" @bind="BatchStockId" placeholder="例如: 2330" class="dark-input" />
                    <button @onclick="SyncFromApi" class="action-btn" disabled="@IsProcessing">⚡ 執行 API 同步</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="status-box @(IsError ? "error" : "success")">
                    @StatusMessage
                </div>
            }
        </div>
        <div class="card-box">
            <h3 class="card-title">📝 單筆數據維護 (INSERT / UPDATE)</h3>
            <div class="form-group">
                <label>股票代號</label>
                <input type="text" @bind="InputPrice.StockId" placeholder="例如: 2330" class="dark-input w-100" />
            </div>
            <div class="form-group">
                <label>交易日期</label>
                <input type="text" @bind="InputPrice.TradeDate" placeholder="YYYY-MM-DD" class="dark-input w-100" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>開盤價</label>
                    <input type="number" step="0.01" @bind="InputPrice.OpenPrice" class="dark-input" />
                </div>
                <div class="form-group">
                    <label>最高價</label>
                    <input type="number" step="0.01" @bind="InputPrice.HighPrice" class="dark-input" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>最低價</label>
                    <input type="number" step="0.01" @bind="InputPrice.LowPrice" class="dark-input" />
                </div>
                <div class="form-group">
                    <label>收盤價</label>
                    <input type="number" step="0.01" @bind="InputPrice.ClosePrice" class="dark-input" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>成交股數 (Volume)</label>
                    <input type="number" @bind="InputPrice.Volume" class="dark-input" />
                </div>
                <div class="form-group">
                    <label>成交金額 (Amount)</label>
                    <input type="number" @bind="InputPrice.Amount" class="dark-input" />
                </div>
            </div>
            <button @onclick="SaveSinglePrice" class="action-btn mt-10 w-100" disabled="@IsProcessing">
                💾 儲存至 SQLite
            </button>
        </div>

    </div>
</div>
