@page "/stock-query"

<PageTitle>QUANT STACK | 數據查詢</PageTitle>

<div class="dashboard-panel">
    <div class="panel-header">
        <h2 class="panel-title">📊 單機股市歷史資料查詢</h2>
        <span class="panel-subtitle">本機 SQLite 資料庫連線中</span>
    </div>

    <div class="search-box-container">
        <div class="search-input-wrapper">
            <span class="search-icon">🔍</span>
            <input type="text" @bind="TargetStockId" placeholder="輸入股票代號 (如: 2330)" class="dark-input" />
        </div>
        <button @onclick="SearchStock" class="action-btn">執行檢索</button>
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert-box">⚠️ @Message</div>
    }

    @if (StockResult != null)
    {
        <div class="table-container">
            <table class="financial-table">
                <thead>
                    <tr>
                        <th>評估指標</th>
                        <th>資料庫存取數值</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>股票代號</td><td class="highlight-text">@StockResult.StockId</td></tr>
                    @* TODO: 待 StockList 資料表完成後，在此補上「商品名稱」 *@
                    <tr><td>最新收盤價</td><td class="price-up">$ @(StockResult.ClosePrice?.ToString("N2") ?? "-")</td></tr>
                    <tr><td>成交股數</td><td>@(StockResult.Volume?.ToString("N0") ?? "-")</td></tr>
                    <tr><td>本機最新交易日</td><td class="time-text">@StockResult.TradeDate</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
