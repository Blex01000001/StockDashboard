@page "/stock-chart"

<PageTitle>QUANT STACK | 技術圖表</PageTitle>

<div class="dashboard-panel panel-standard">
    <div class="panel-header">
        <h2 class="panel-title">📈 K線技術指標圖表</h2>
        <span class="panel-subtitle">本機 SQLite 資料串接</span>
    </div>

    <div class="search-box-container">
        <div class="search-input-wrapper">
            <span class="search-icon">🔍</span>
            <input type="text" @bind="State.TargetStockId" placeholder="輸入股票代號 (如: 2330)" class="dark-input" list="stock-id-options" />
            <StockIdDataList Id="stock-id-options" />
        </div>
        <select class="dark-input count-select" value="@State.CandleCount" @onchange="OnCountChanged" title="顯示最近幾根 K 線（均線與指標都以完整歷史計算）">
            @foreach (var (value, label) in StockDashboard.Services.StockChartState.CountOptions)
            {
                <option value="@value">@label</option>
            }
        </select>
        <label class="adj-toggle" title="依除權息資料還原價格；需先到「API 資料更新」同步除權除息">
            <input type="checkbox" checked="@State.Adjusted" @onchange="OnAdjustedChanged" />
            <span>還原股價</span>
        </label>
        <button @onclick="LoadChartData" class="action-btn">繪製圖表</button>
    </div>

    @* 附圖、指標參數、均線：與型態掃描頁同一個元件 (面板版面) *@
    <div class="chart-options">
        <ChartDisplayOptions Settings="State.Display" OnChanged="OnDisplayChanged" Framed="true" />
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert-box">⚠️ @Message</div>
    }

    <div id="chart-container" style="width: 100%; height: 500px; background-color: #1e222d; margin-top: 20px;"></div>
</div>
