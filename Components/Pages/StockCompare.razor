@page "/stock-compare"

<PageTitle>QUANT STACK | 多檔績效比較</PageTitle>

<div class="dashboard-panel">
    <div class="panel-header">
        <h2 class="panel-title">
            <span class="title-icon">📈</span> 股票資本利得報酬比較
        </h2>
        <p class="panel-subtitle">輸入多檔股票代號，快速對比歷史報酬率走勢</p>
    </div>

    <div class="search-box-container">

        <div class="search-input-group">
            <label class="input-label">
                <span class="label-icon">🏷️</span> 股票代號
            </label>
            <div class="input-wrapper">
                <input type="text"
                       @bind="StockIdsInput"
                       placeholder="例如: 0050, 006208 (以逗號隔開)"
                       class="dark-input" />
            </div>
        </div>
        <div class="search-input-group">
            <label class="input-label">
                <span class="label-icon">📅</span> 報酬區間
            </label>
            <div class="input-wrapper">
                <select @bind="SelectedDays" class="dark-input select-custom">
                    <option value="5">5 天</option>
                    <option value="10">10 天</option>
                    <option value="20">20 天</option>
                    <option value="60">60 天</option>
                    <option value="120">120 天</option>
                    <option value="220">220 天</option>
                </select>
            </div>
        </div>

        <div class="search-action-group">
            <button @onclick="CompareStocks" class="action-btn">
                <span class="btn-icon">⚡</span> 開始比較
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert-box">
            <span class="alert-icon">⚠️</span>
            <span class="alert-text">@Message</span>
        </div>
    }

    <div class="chart-wrapper">
        <div id="compare-chart-container" class="chart-container"></div>
    </div>
</div>
