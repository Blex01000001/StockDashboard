@page "/stock-update"

<PageTitle>QUANT STACK | 資料更新</PageTitle>

<div class="dashboard-panel panel-standard">
    <div class="panel-header">
        <h2 class="panel-title">⚙️ API 資料更新面板</h2>
        <span class="panel-subtitle">依資料來源分組，從外部 API 更新本機 SQLite 資料庫</span>
    </div>

    @* ── 來源：證交所 ── *@
    <section class="source-group">
        <div class="source-header">
            <span class="source-name">🏛️ 證交所 TWSE</span>
            <span class="source-note">日線一次一檔一個月；三大法人一次一天、全部上市股票</span>
        </div>

        <div class="update-grid">
            <div class="card-box">
                <h3 class="card-title">🌐 日線批次同步</h3>
                <div class="api-url"><code>twse.com.tw/exchangeReport/STOCK_DAY</code></div>
                <p class="description">逐月抓取歷史 K 線資料，並使用 <code class="code-tag">INSERT OR REPLACE</code> 覆寫或更新本機 SQLite 資料。</p>

                <div class="form-group">
                    <label>更新時間範圍</label>
                    <select @bind="SelectedRange" class="dark-input w-100" style="padding-right: 10px;">
                        <option value="1">本月</option>
                        <option value="3">近三個月</option>
                        <option value="12">近一年</option>
                        <option value="36">近三年 (36個月)</option>
                        <option value="60">近五年 (60個月)</option>
                        <option value="120">近十年 (120個月)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>指定股票代號</label>
                    <div class="search-box-container">
                        <input type="text" @bind="BatchStockId" placeholder="例如: 2330" class="dark-input" list="stock-id-options" />
                        <button @onclick="SyncFromApi" class="action-btn" disabled="@IsProcessing">⚡ 執行 API 同步</button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <div class="status-box @(IsError ? "error" : "success")">
                        @StatusMessage
                    </div>
                }
            </div>

            <div class="card-box">
                <h3 class="card-title">🏦 三大法人（逐日，全部上市股票）</h3>
                <div class="api-url"><code>twse.com.tw/fund/T86</code>　<code>twse.com.tw/fund/MI_QFIIS</code></div>
                <p class="description">
                    下載每日「三大法人買賣超」與「外資持股」，一天兩個請求（間隔約 2.5 秒），適合補最近幾天。
                    已下載的日期與確認過的休市日會自動略過；多年資料請用下方 FinMind 個股同步。
                </p>

                <div class="form-group">
                    <label>同步範圍</label>
                    <div class="search-box-container">
                        <select @bind="InstitutionalRange" class="dark-input" disabled="@IsSyncingInstitutional">
                            @foreach (var option in InstitutionalRangeOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                        @if (IsSyncingInstitutional)
                        {
                            <button @onclick="StopInstitutionalSync" class="action-btn">⏹ 停止</button>
                        }
                        else
                        {
                            <button @onclick="SyncInstitutional" class="action-btn">🔄 同步三大法人</button>
                        }
                    </div>
                </div>

                <p class="description summary-line">
                    @if (InstitutionalSummary is { Days: > 0 } summary)
                    {
                        <span>資料庫已有：<b>@summary.FirstDate</b> ～ <b>@summary.LastDate</b>，共 <b>@summary.Days</b> 個交易日（含 FinMind）</span>
                    }
                    else
                    {
                        <span>尚未下載任何三大法人資料</span>
                    }
                </p>

                @if (!string.IsNullOrEmpty(InstitutionalStatusMessage))
                {
                    <div class="status-box @(InstitutionalIsError ? "error" : "success")">
                        @InstitutionalStatusMessage
                    </div>
                }
            </div>

            <div class="card-box card-wide">
                <h3 class="card-title">📋 股票清單同步</h3>
                <div class="api-url"><code>openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL</code></div>
                <p class="description">
                    下載所有上市股票與 ETF 的代號、名稱，存入 <code class="code-tag">StockNameList</code>
                    （不會修改原有的 <code class="code-tag">StockList</code> 上市公司基本資料；兩者都有的代號以公司基本資料的簡稱為準）。
                    同步後，查詢頁會顯示股票名稱、圖表會顯示「代號 名稱」，輸入股票代號時也會出現自動完成選單。
                </p>

                <div class="list-sync-row">
                    <span class="description list-summary">
                        @if (NameSummary != null)
                        {
                            @if (NameSummary.CompanyCount != null)
                            {
                                <span>上市公司基本資料：<b>@NameSummary.CompanyCount</b> 家　｜　</span>
                            }
                            <span>證交所同步清單：<b>@NameSummary.SyncedCount</b> 檔</span>
                            @if (NameSummary.LastSyncedAt != null)
                            {
                                <span>（最後更新：@NameSummary.LastSyncedAt）</span>
                            }
                        }
                    </span>
                    <button @onclick="SyncStockList" class="action-btn" disabled="@IsSyncingList">🔄 更新股票清單</button>
                </div>

                @if (!string.IsNullOrEmpty(ListStatusMessage))
                {
                    <div class="status-box @(ListIsError ? "error" : "success")">
                        @ListStatusMessage
                    </div>
                }
            </div>

            <div class="card-box card-wide">
                <h3 class="card-title">🏭 依產業別批次同步日線（全部歷史）</h3>
                <div class="api-url"><code>twse.com.tw/exchangeReport/STOCK_DAY</code></div>
                <p class="description">
                    選擇 <code class="code-tag">StockList</code> 的「產業別」（例如 24 半導體業），該產業每一檔股票都會由本月往前逐月下載，直到上市日（有多少撈多少）。
                    請求間隔約 3 秒，整個產業可能要跑好幾個小時：<b>可以離開頁面或關閉分頁，網站程式開著就會繼續跑</b>。
                    已完整的歷史月份不會重抓；被證交所封鎖或按「停止」後，再按一次會接著跑。
                </p>

                <div class="list-sync-row">
                    <span class="btn-pair">
                        <select @bind="IndustryCodeInput" class="dark-input" disabled="@IndustryRunner.IsRunning">
                            <option value="">請選擇產業別</option>
                            @foreach (var industry in Industries)
                            {
                                <option value="@industry.Code">@industry.Label</option>
                            }
                        </select>
                    </span>
                    @if (IndustryRunner.IsRunning)
                    {
                        <button @onclick="StopIndustrySync" class="action-btn stop-btn">⏹ 停止</button>
                    }
                    else
                    {
                        <button @onclick="StartIndustrySync" class="action-btn">🏭 開始同步</button>
                    }
                </div>

                @if (!string.IsNullOrEmpty(IndustryStatusMessage))
                {
                    <div class="status-box @(IndustryIsError ? "error" : "success")">
                        @IndustryStatusMessage
                    </div>
                }
            </div>
        </div>
    </section>

    @* ── 來源：FinMind ── *@
    <section class="source-group">
        <div class="source-header">
            <span class="source-name">📦 FinMind</span>
            <span class="source-note">一次一檔、整段期間（三大法人 2012-05-02 起、除權息 2003 年起）；匿名使用，IP 被封鎖時立即停止</span>
        </div>

        <div class="update-grid">
            <div class="card-box card-wide">
                <h3 class="card-title">🏦 三大法人（個股，多年）</h3>
                <div class="api-url">
                    <code>api.finmindtrade.com/api/v4/data?dataset=TaiwanStockInstitutionalInvestorsBuySell</code>
                    <code>api.finmindtrade.com/api/v4/data?dataset=TaiwanStockShareholding</code>
                </div>
                <p class="description">
                    每檔股票兩個請求（買賣超、外資持股），寫入與證交所相同的 <code class="code-tag">InstitutionalDaily</code>。
                    第一次從 2012-05-02 抓到今天；之後只從上次同步日往前 @StockDashboard.Services.FinMindSyncService.OverlapDays 天開始補。
                </p>

                <div class="form-group">
                    <label>股票代號（可多檔，以逗號分隔）</label>
                    <div class="search-box-container">
                        <input type="text" @bind="FinMindStockIds" placeholder="例如: 2330,0050" class="dark-input" list="stock-id-options" disabled="@IsSyncingFinMind" />
                        @if (IsSyncingFinMind)
                        {
                            <button @onclick="StopFinMindSync" class="action-btn">⏹ 停止</button>
                        }
                        else
                        {
                            <button @onclick="SyncFinMind" class="action-btn">🔄 同步三大法人</button>
                        }
                    </div>
                </div>

                <label class="description full-reload">
                    <input type="checkbox" @bind="FinMindFullReload" disabled="@IsSyncingFinMind" />
                    重新完整下載（忽略同步紀錄，從 2012-05-02 起）
                </label>

                <p class="description summary-line">已用 FinMind 同步過：<b>@FinMindSyncedCount</b> 檔</p>

                @if (!string.IsNullOrEmpty(FinMindStatusMessage))
                {
                    <div class="status-box @(FinMindIsError ? "error" : "success")">
                        @FinMindStatusMessage
                    </div>
                }
            </div>

            <div class="card-box card-wide">
                <h3 class="card-title">✂️ 除權除息（還原股價用）</h3>
                <div class="api-url">
                    <code>api.finmindtrade.com/api/v4/data?dataset=TaiwanStockDividendResult</code>
                </div>
                <p class="description">
                    每檔股票一個請求，取回 2003 年起的除權息前收盤與參考價，存入 <code class="code-tag">StockExRightEvent</code>。
                    目前只存資料，圖表與型態掃描尚未使用。
                </p>

                <div class="form-group">
                    <label>股票代號（可多檔，以逗號分隔）</label>
                    <div class="search-box-container">
                        <input type="text" @bind="ActionStockIds" placeholder="例如: 2330,0050" class="dark-input" list="stock-id-options" disabled="@IsSyncingAction" />
                        @if (IsSyncingAction)
                        {
                            <button @onclick="StopActionSync" class="action-btn">⏹ 停止</button>
                        }
                        else
                        {
                            <button @onclick="SyncActions" class="action-btn">🔄 同步除權除息</button>
                        }
                    </div>
                </div>

                @if (ActionSummary is { Events: > 0 })
                {
                    <p class="description summary-line">已有 <b>@ActionSummary.Value.Stocks</b> 檔、<b>@ActionSummary.Value.Events</b> 筆除權息事件</p>
                }

                @if (!string.IsNullOrEmpty(ActionStatusMessage))
                {
                    <div class="status-box @(ActionIsError ? "error" : "success")">
                        @ActionStatusMessage
                    </div>
                }
            </div>
        </div>
    </section>

    @* ── 來源：oilpriceapi.com ── *@
    <section class="source-group">
        <div class="source-header">
            <span class="source-name">🛢️ oilpriceapi.com</span>
            <span class="source-note">Brent 原油；需 API Key（設定 OilPrice:ApiKey）；免費方案每天 50 次</span>
        </div>

        <div class="update-grid">
            <div class="card-box card-wide">
                <h3 class="card-title">🛢️ 原油價格（Brent）</h3>
                <div class="api-url"><code>api.oilpriceapi.com/v1/prices/past_year?by_code=BRENT_CRUDE_USD</code></div>
                <p class="description">
                    一次請求取回最近一年的每日價格（當日均價，美元 / 桶），存入 <code class="code-tag">OilPriceDaily</code>，
                    供型態掃描與技術圖表的「原油」附圖使用。來源只提供一年，更早的資料靠每次同步慢慢累積（已存的不會刪）。
                    附圖上每個交易日顯示的是「當天之前」最近一筆價格。
                </p>

                <div class="list-sync-row">
                    <span class="description list-summary">
                        @if (OilSummary is { Days: > 0 })
                        {
                            <span>已有 <b>@OilSummary.Value.Days</b> 天（@OilSummary.Value.FirstDate ~ @OilSummary.Value.LastDate）</span>
                        }
                        else
                        {
                            <span>尚未同步</span>
                        }
                    </span>
                    <button @onclick="SyncOil" class="action-btn" disabled="@IsSyncingOil">🔄 同步原油價格</button>
                </div>

                @* API Key 要寫在 appsettings.json：這裡直接開啟設定檔或所在資料夾 (開在執行網站的這台電腦) *@
                <div class="list-sync-row">
                    <span class="description list-summary">API Key 設定檔：<code class="code-tag">@PathOpener.SettingsFilePath</code></span>
                    <span class="btn-pair">
                        <button @onclick="OpenSettingsFile" class="action-btn">📝 開啟 appsettings.json</button>
                        <button @onclick="OpenSettingsFolder" class="action-btn">📂 開啟資料夾</button>
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(OilStatusMessage))
                {
                    <div class="status-box @(OilIsError ? "error" : "success")">
                        @OilStatusMessage
                    </div>
                }
            </div>
        </div>
    </section>

    @* ── 來源：Yahoo Finance ── *@
    <section class="source-group">
        <div class="source-header">
            <span class="source-name">📈 Yahoo Finance</span>
            <span class="source-note">美股指數日線；不需 API Key（非官方 API，可能被擋或改格式）</span>
        </div>

        <div class="update-grid">
            <div class="card-box card-wide">
                <h3 class="card-title">💽 費城半導體指數（SOX）</h3>
                <div class="api-url"><code>query1.finance.yahoo.com/v8/finance/chart/%5ESOX?interval=1d</code></div>
                <p class="description">
                    一次請求取回最近一年的日線（開高低收），存入 <code class="code-tag">MarketIndexDaily</code>，
                    供型態掃描與技術圖表的「費半」附圖使用。來源只抓一年，更早的資料靠每次同步慢慢累積（已存的不會刪）。
                    附圖上每個台股交易日顯示「它之前已收盤的美股」；台股連假期間的多個美股交易日會合併成一根。
                </p>

                <div class="list-sync-row">
                    <span class="description list-summary">
                        @if (SoxSummary is { Days: > 0 })
                        {
                            <span>已有 <b>@SoxSummary.Value.Days</b> 天（@SoxSummary.Value.FirstDate ~ @SoxSummary.Value.LastDate，美股日期）</span>
                        }
                        else
                        {
                            <span>尚未同步</span>
                        }
                    </span>
                    <button @onclick="SyncSox" class="action-btn" disabled="@IsSyncingSox">🔄 同步費半</button>
                </div>

                @if (!string.IsNullOrEmpty(SoxStatusMessage))
                {
                    <div class="status-box @(SoxIsError ? "error" : "success")">
                        @SoxStatusMessage
                    </div>
                }
            </div>

            <div class="card-box card-wide">
                <h3 class="card-title">🛢️ Brent 原油期貨（BZ=F）</h3>
                <div class="api-url"><code>query1.finance.yahoo.com/v8/finance/chart/BZ%3DF?interval=1d</code></div>
                <p class="description">
                    一次請求取回 2007 年起的全部日線，只存<b>收盤價</b>到 <code class="code-tag">OilPriceDaily</code>（代號 <code class="code-tag">@StockDashboard.Services.YahooOilSyncService.Code</code>），
                    供「原油 (Yahoo)」附圖使用，可和 oilpriceapi 的「原油 (oilpriceapi)」附圖（當日均價）並排比較。
                </p>

                <div class="list-sync-row">
                    <span class="description list-summary">
                        @if (YahooOilSummary is { Days: > 0 })
                        {
                            <span>已有 <b>@YahooOilSummary.Value.Days</b> 天（@YahooOilSummary.Value.FirstDate ~ @YahooOilSummary.Value.LastDate）</span>
                        }
                        else
                        {
                            <span>尚未同步</span>
                        }
                    </span>
                    <button @onclick="SyncYahooOil" class="action-btn" disabled="@IsSyncingYahooOil">🔄 同步 Yahoo 原油</button>
                </div>

                @if (!string.IsNullOrEmpty(YahooOilStatusMessage))
                {
                    <div class="status-box @(YahooOilIsError ? "error" : "success")">
                        @YahooOilStatusMessage
                    </div>
                }
            </div>
        </div>
    </section>

    <StockIdDataList Id="stock-id-options" @ref="_stockIdDataList" />
</div>
