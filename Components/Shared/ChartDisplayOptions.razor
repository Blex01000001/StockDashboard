@using StockDashboard.Models.Patterns
@using StockDashboard.Services
@* 附圖勾選、指標參數、顯示均線：型態掃描與技術圖表共用 (Framed = 技術圖表頁用面板版面，否則為型態掃描頁的收折版面)。改動後呼叫 OnChanged，由頁面重畫圖表 *@

@if (Framed)
{
    @* 技術圖表頁：一個設定面板，每列「標籤 ＋ 內容」。MACD、KD、RSI、布林通道的參數直接放在各自的勾選框旁，
       框成一組 (同型態掃描頁的參數)：勾選才亮起、才能調整 *@
    <div class="options-panel">
        <div class="opt-row">
            <span class="opt-label">附圖</span>
            <div class="opt-body">
                @FramedSubChartToggles()
                <span class="opt-hint">可複選；要調整順序，請拖曳圖上附圖左側的 ≡。依序疊在 K 線下方</span>
            </div>
        </div>
        <div class="opt-row">
            <span class="opt-label">均線</span>
            <div class="opt-body">@FramedMovingAverageToggles()</div>
        </div>
    </div>
}
else
{
    <div class="ctl-field">
        <span>附圖（可複選，可拖曳調整順序，依序疊在 K 線下方）</span>
        <div class="ma-toggles">@SubChartToggles()</div>
    </div>
    @foreach (var group in IndicatorGroups.Where(IsGroupVisible))
    {
        @* 指標參數平常收折；調整後立即用已載入的日線重算 *@
        <details class="indicator-params" data-indicator="@group.SubChart">
            <summary>@group.Title 參數（@string.Join(", ", group.Params.Select(p => p.Get(Settings.Indicators)))）</summary>
            <div class="indicator-grid" style="grid-template-columns: repeat(@group.Params.Length, 1fr)">
                @foreach (var param in group.Params)
                {
                    <label>@param.Label<input type="number" min="1" max="@IndicatorSettings.MaxPeriod" class="dark-input @param.CssClass"
                                             value="@param.Get(Settings.Indicators)" @onchange="e => OnIndicatorChanged(group, param, e)" /></label>
                }
            </div>
            <div class="indicator-foot">
                @if (IndicatorErrors.TryGetValue(group.SubChart, out var error))
                {
                    <span class="indicator-error">@error</span>
                }
                <button class="link-btn" @onclick="() => ResetIndicator(group)">預設 @string.Join(", ", group.Params.Select(p => p.Get(DefaultIndicators)))</button>
            </div>
        </details>
    }
    <div class="ctl-field">
        <span>顯示均線</span>
        <div class="ma-toggles">@MovingAverageToggles()</div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ChartDisplaySettings Settings { get; set; } = default!;


    // ── 技術圖表頁 (Framed) 的勾選 + 參數 ──
    private static IndicatorGroup GroupOf(string subChart) => IndicatorGroups.First(g => g.SubChart == subChart);

    // 附圖勾選：固定依預設順序排 (實際疊圖順序在圖上拖曳調整)；MACD、KD、RSI 的參數放在勾選框旁
    private RenderFragment FramedSubChartToggles() => @<text>
        @foreach (var (value, label) in ChartDisplaySettings.SubChartOptions)
        {
            var key = value;
            if (IndicatorGroups.Any(g => g.SubChart == key))
            {
                @IndicatorBox(GroupOf(key), label, Settings.SubCharts.Contains(key), e => OnSubChartToggled(key, e))
            }
            else
            {
                <label class="ma-toggle sub-toggle">
                    <input type="checkbox" checked="@Settings.SubCharts.Contains(key)" @onchange="e => OnSubChartToggled(key, e)" />
                    <span>@label</span>
                </label>
            }
        }
        @if (!Settings.IsDefaultSubChartOrder)
        {
            <button class="link-btn" @onclick="ResetSubChartOrder">恢復預設順序</button>
        }
    </text>;

    // 均線勾選 + 布林通道 (參數放在勾選框旁)
    private RenderFragment FramedMovingAverageToggles() => @<text>
        @foreach (var period in ChartDisplaySettings.MovingAveragePeriods)
        {
            <label class="ma-toggle">
                <input type="checkbox" checked="@Settings.VisibleMovingAverages.Contains(period)" @onchange="e => OnMovingAverageToggled(period, e)" />
                <span>@period</span>
            </label>
        }
        @IndicatorBox(GroupOf("boll"), "布林通道", Settings.Indicators.Bollinger, OnBollingerToggled)
    </text>;

    // 一組：勾選框 + 該指標的參數輸入框 + 「預設」；未勾選時整組淡化、輸入框不能改
    private RenderFragment IndicatorBox(IndicatorGroup group, string label, bool on, Func<ChangeEventArgs, Task> onToggle) => @<span class="ind-group @(on ? "on" : "off")" data-indicator="@group.SubChart">
        <label class="ma-toggle sub-toggle">
            <input type="checkbox" checked="@on" @onchange="onToggle" />
            <span>@label</span>
        </label>
        @foreach (var param in group.Params)
        {
            <label class="ind-field">
                <span>@param.Label</span>
                <input type="number" min="1" max="@IndicatorSettings.MaxPeriod" class="dark-input @param.CssClass" disabled="@(!on)"
                       value="@param.Get(Settings.Indicators)" @onchange="e => OnIndicatorChanged(group, param, e)" />
            </label>
        }
        <button class="link-btn" disabled="@(!on)" title="恢復預設 @string.Join(", ", group.Params.Select(p => p.Get(DefaultIndicators)))" @onclick="() => ResetIndicator(group)">預設</button>
        @if (on && IndicatorErrors.TryGetValue(group.SubChart, out var error))
        {
            <span class="indicator-error">@error</span>
        }
    </span>;

    // 附圖勾選 (型態掃描頁；不可拖曳排序，順序固定為預設)
    private RenderFragment SubChartToggles() => @<text>
        @foreach (var value in Settings.SubChartOrder)
        {
            <label class="ma-toggle sub-toggle">
                <input type="checkbox" checked="@Settings.SubCharts.Contains(value)" @onchange="e => OnSubChartToggled(value, e)" />
                <span>@SubChartLabels[value]</span>
            </label>
        }
    </text>;

    // 均線勾選；布林通道畫在 K 線上，和均線放同一組 (參數在指標參數區)
    private RenderFragment MovingAverageToggles() => @<text>
        @foreach (var period in ChartDisplaySettings.MovingAveragePeriods)
        {
            <label class="ma-toggle">
                <input type="checkbox" checked="@Settings.VisibleMovingAverages.Contains(period)" @onchange="e => OnMovingAverageToggled(period, e)" />
                <span>@period</span>
            </label>
        }
        <label class="ma-toggle sub-toggle">
            <input type="checkbox" checked="@Settings.Indicators.Bollinger" @onchange="OnBollingerToggled" />
            <span>布林通道</span>
        </label>
    </text>;

    // true：附圖、均線各自用框線圍成一組 (技術圖表頁)；型態掃描頁的控制框已有外框，不需要
    [Parameter] public bool Framed { get; set; }

    // 參數 = 指標參數是否改變 (true 時頁面需重算指標再重畫；false 只需重畫)
    [Parameter] public EventCallback<bool> OnChanged { get; set; }

    // 各附圖的可調參數：新增指標時在這裡加一組即可 (畫面自動產生收合的輸入框)
    public record IndicatorParam(string Label, string CssClass, Func<IndicatorSettings, int> Get, Action<IndicatorSettings, int> Set);
    public record IndicatorGroup(string SubChart, string Title, IndicatorParam[] Params);

    public static readonly IndicatorGroup[] IndicatorGroups =
    {
        new("macd", "MACD", new IndicatorParam[]
        {
            new("快線", "macd-fast", s => s.MacdFast, (s, v) => s.MacdFast = v),
            new("慢線", "macd-slow", s => s.MacdSlow, (s, v) => s.MacdSlow = v),
            new("訊號", "macd-signal", s => s.MacdSignal, (s, v) => s.MacdSignal = v),
        }),
        new("kd", "KD", new IndicatorParam[]
        {
            new("RSV天數", "kd-period", s => s.KdPeriod, (s, v) => s.KdPeriod = v),
            new("K平滑", "kd-k", s => s.KdKSmooth, (s, v) => s.KdKSmooth = v),
            new("D平滑", "kd-d", s => s.KdDSmooth, (s, v) => s.KdDSmooth = v),
        }),
        new("rsi", "RSI", new IndicatorParam[]
        {
            new("短週期", "rsi-fast", s => s.RsiFast, (s, v) => s.RsiFast = v),
            new("長週期", "rsi-slow", s => s.RsiSlow, (s, v) => s.RsiSlow = v),
        }),
        // 布林通道不是附圖：識別字 "boll" 只在勾選布林通道時顯示 (見 IsGroupVisible)
        new("boll", "布林通道", new IndicatorParam[]
        {
            new("天數", "boll-period", s => s.BollPeriod, (s, v) => s.BollPeriod = v),
            new("標準差倍數", "boll-mult", s => s.BollMultiplier, (s, v) => s.BollMultiplier = v),
        }),
    };

    private static readonly IndicatorSettings DefaultIndicators = new();

    // 各附圖參數的錯誤訊息 (Key = 附圖識別字)
    private Dictionary<string, string> IndicatorErrors { get; } = new();

    private static readonly Dictionary<string, string> SubChartLabels = ChartDisplaySettings.SubChartOptions.ToDictionary(o => o.Value, o => o.Label);

    private Task ResetSubChartOrder()
    {
        Settings.ResetSubChartOrder();
        return OnChanged.InvokeAsync(false);
    }

    private Task OnSubChartToggled(string value, ChangeEventArgs e)
    {
        if (e.Value is true) Settings.SubCharts.Add(value);
        else Settings.SubCharts.Remove(value);
        return OnChanged.InvokeAsync(false);
    }

    private bool IsGroupVisible(IndicatorGroup g) =>
        g.SubChart == "boll" ? Settings.Indicators.Bollinger : Settings.SubCharts.Contains(g.SubChart);

    private Task OnBollingerToggled(ChangeEventArgs e)
    {
        var settings = Settings.Indicators.Clone();
        settings.Bollinger = e.Value is true;
        Settings.Indicators = settings;
        return OnChanged.InvokeAsync(true);   // 需要計算 (或清掉) 上下軌
    }

    private Task OnMovingAverageToggled(int period, ChangeEventArgs e)
    {
        if (e.Value is true) Settings.VisibleMovingAverages.Add(period);
        else Settings.VisibleMovingAverages.Remove(period);
        return OnChanged.InvokeAsync(false);
    }

    private Task OnIndicatorChanged(IndicatorGroup group, IndicatorParam param, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int value))
        {
            IndicatorErrors[group.SubChart] = "請輸入整數";
            return Task.CompletedTask;
        }

        var settings = Settings.Indicators.Clone();
        param.Set(settings, value);

        // 不合理的組合 (例如快線 ≥ 慢線) 不套用，只顯示原因
        string? error = settings.Validate(group.SubChart);
        if (error != null)
        {
            IndicatorErrors[group.SubChart] = error;
            return Task.CompletedTask;
        }
        IndicatorErrors.Remove(group.SubChart);
        Settings.Indicators = settings;
        return OnChanged.InvokeAsync(true);
    }

    private Task ResetIndicator(IndicatorGroup group)
    {
        var settings = Settings.Indicators.Clone();
        foreach (var p in group.Params) p.Set(settings, p.Get(DefaultIndicators));
        IndicatorErrors.Remove(group.SubChart);
        Settings.Indicators = settings;
        return OnChanged.InvokeAsync(true);
    }
}
