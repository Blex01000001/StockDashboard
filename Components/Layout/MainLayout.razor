@inherits LayoutComponentBase

<div class="app-layout">
    <NavMenu @bind-IsCollapsed="SidebarCollapsed" />

    <main class="main-content">
        <div class="content-container">
            @Body
        </div>
    </main>
</div>

@code {
    // 全局管理側邊欄是否收折
    private bool SidebarCollapsed { get; set; } = false;
}

<style>
    :root {
        --bg-main: #121318; /* 專業極深灰底色 */
        --bg-sidebar: #1a1c24; /* 側邊欄稍淺黑 */
        --bg-card: #1e222d; /* 卡片/表格底色 */
        --text-main: #d1d4dc; /* 主文字淡灰（護眼不刺眼） */
        --text-muted: #787b86; /* 次要文字 */
        --accent-color: #2962ff; /* 財經專業藍 (TradingView 藍) */
        --border-color: #2a2e39; /* 精細線條顏色 */
    }

    /* 基礎重設 */
    body {
        margin: 0;
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .app-layout {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    /* 側邊欄樣式與動畫 */
    .sidebar-container {
        width: 240px;
        background-color: var(--bg-sidebar);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .sidebar-container.collapsed {
            width: 60px;
        }

    .sidebar-header {
        height: 60px;
        display: flex;
        align-items: center;
        padding: 0 18px;
        border-bottom: 1px solid var(--border-color);
        overflow: hidden;
        white-space: nowrap;
    }

    .brand-logo {
        font-size: 1.2rem;
        margin-right: 12px;
    }

    .brand-name {
        font-weight: bold;
        font-size: 0.95rem;
        letter-spacing: 1px;
        color: #ffffff;
        transition: opacity 0.15s ease;
    }

    .sidebar-container.collapsed .brand-name {
        opacity: 0;
        pointer-events: none;
    }

    .toggle-btn {
        position: absolute;
        right: -12px;
        top: 65px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        z-index: 10;
    }

        .toggle-btn:hover {
            background-color: var(--accent-color);
            color: #fff;
        }

    /* 導覽選單 */
    .nav-list {
        padding: 15px 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .nav-link {
        display: flex;
        align-items: center;
        padding: 12px 18px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .nav-link:hover, .nav-link.active {
            color: #ffffff;
            background-color: #232733;
        }

        .nav-link.active {
            border-left: 3px solid var(--accent-color);
            padding-left: 15px;
        }

    .nav-icon {
        font-size: 1.1rem;
        margin-right: 15px;
        min-width: 24px;
    }

    .sidebar-container.collapsed .nav-text {
        opacity: 0;
        pointer-events: none;
    }

    .nav-link.disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    /* 主內容區 */
    .main-content {
        flex: 1;
        overflow-y: auto;
        background-color: var(--bg-main);
    }

    .content-container {
        padding: 10px;
        max-width: 1400px;
        margin: 0 auto;
    }
</style>