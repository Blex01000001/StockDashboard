@page "/pattern-scan"

<PageTitle>QUANT STACK | K線型態掃描</PageTitle>

<div class="dashboard-panel panel-standard">
    <div class="panel-header pattern-header">
        <h2 class="panel-title">🕯️ K線型態掃描</h2>
        <span class="panel-subtitle">從本機資料庫找出符合型態的日子，顯示前 @DaysBefore 天與後 @DaysAfter 天的走勢</span>
    </div>

    <div class="control-row">
        @* ── 掃描設定 ── *@
        <div class="ctl-box">
            <div class="ctl-title">掃描設定</div>
            <label class="ctl-field">
                <span>型態</span>
                <select class="dark-input pattern-select" value="@Pattern.Key" @onchange="OnPatternChanged">
                    @foreach (var p in Patterns)
                    {
                        <option value="@p.Key">@p.Name</option>
                    }
                </select>
            </label>
            <label class="ctl-field">
                <span>股票清單</span>
                <input type="text" @bind="State.StockIdsInput" placeholder="以逗號分隔，如: 2330, 0050" class="dark-input stock-list-input" />
            </label>
            <div class="ctl-pair">
                <label class="ctl-field">
                    <span>每頁筆數</span>
                    <select class="dark-input page-size-select" value="@State.PageSize" @onchange="OnPageSizeChanged">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </label>
                <label class="ctl-field" title="除了 5 / 10 / 20 日之外，再計算這些天數的報酬與勝率；多組以逗號分隔，1 ~ 250 天（掃描後生效）">
                    <span>額外觀察天數</span>
                    <input type="text" placeholder="例如 60,120" class="dark-input extra-horizon-input" @bind="State.ExtraHorizonsInput" />
                </label>
            </div>
        </div>

        @* ── 型態參數 (依型態的參數定義自動產生) ── *@
        <div class="ctl-box">
            <div class="ctl-title">
                @Pattern.Name 參數
                <button class="link-btn" @onclick="ResetValues">恢復預設</button>
            </div>
            <div class="param-grid">
                @foreach (var item in ParameterLayout)
                {
                    if (item.IsGroup)
                    {
                        @* 勾選參數與它控制的數值放在同一個框內，表示是一組設定 *@
                        bool on = Values.GetBool(item.Head.Key);
                        <div class="param-group @(on ? "on" : "off")">
                            <label class="param toggle group-head">
                                <input type="checkbox" checked="@on" @onchange="e => OnToggle(item.Head, e)" />
                                <span>@item.Head.Label</span>
                            </label>
                            @foreach (var child in item.Children)
                            {
                                @NumberParam(child, on)
                            }
                        </div>
                    }
                    else if (item.Head.Kind == Models.Patterns.PatternParameterKind.Toggle)
                    {
                        <label class="param toggle">
                            <input type="checkbox" checked="@Values.GetBool(item.Head.Key)" @onchange="e => OnToggle(item.Head, e)" />
                            <span>@item.Head.Label</span>
                        </label>
                    }
                    else
                    {
                        @NumberParam(item.Head, true)
                    }
                }
            </div>
            <div class="scan-row">
                <button @onclick="ScanAsync" class="action-btn scan-btn" disabled="@IsScanning">@(IsScanning ? "掃描中..." : "開始掃描")</button>
            </div>
        </div>

        @* ── 型態範例：依目前參數即時產生 ── *@
        <div class="ctl-box preview-box">
            <div class="ctl-title">型態範例</div>
            <div id="pattern-preview" class="preview-chart"></div>
            <div class="preview-desc">@Pattern.Description</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(State.Message))
    {
        <div class="alert-box">⚠️ @State.Message</div>
    }

    @if (State.Result != null)
    {
        <div class="result-bar">
            <div class="result-summary">
                <span>@State.Result.PatternName：共 <b class="result-count">@State.Result.Matches.Count</b> 筆符合</span>
                @if (State.Result.Matches.Count > 0)
                {
                    <span class="win-rates" title="之後第 N 日的報酬方向符合型態即算勝；之後天數不足的不計入">
                        勝率（@(State.Result.IsBullish ? "上漲" : "下跌")算勝）
                        @foreach (var w in State.Result.WinRates)
                        {
                            <span class="win-rate wr-level-@w.HighlightLevel">
                                @(w.Days)日
                                @if (w.Rate == null)
                                {
                                    <span class="ret-na">-</span>
                                }
                                else
                                {
                                    <b>@w.Rate.Value.ToString("0.0")%</b>
                                    <span class="win-count">(@w.Wins/@w.Total)</span>
                                }
                            </span>
                        }
                    </span>
                }
            </div>
            @if (TotalPages > 1)
            {
                <div class="pager">
                    <button class="link-btn" @onclick="() => GoToPage(State.PageIndex - 1)" disabled="@(State.PageIndex == 0)">‹ 上一頁</button>
                    <span>第 @(State.PageIndex + 1) / @TotalPages 頁</span>
                    <button class="link-btn" @onclick="() => GoToPage(State.PageIndex + 1)" disabled="@(State.PageIndex >= TotalPages - 1)">下一頁 ›</button>
                </div>
            }
        </div>

        @if (State.Result.Matches.Count == 0)
        {
            <div class="empty-hint">沒有符合的日子。可以放寬參數 (例如取消「要求先下跌」、降低實體門檻) 後再掃描。</div>
        }

        <div class="card-grid">
            @for (int i = 0; i < PagedMatches.Count; i++)
            {
                var match = PagedMatches[i];
                <div class="pattern-card">
                    <div class="card-head">
                        <span class="card-stock">@match.StockId @match.StockName</span>
                        <span class="card-date">@match.SignalDate</span>
                    </div>
                    <div id="@($"pattern-chart-{i}")" class="card-chart"></div>
                    <div class="card-returns">
                        @foreach (var days in State.Result.Horizons)
                        {
                            var value = match.ReturnAfter(days);
                            <span>
                                @(days)日
                                @if (value == null)
                                {
                                    <span class="ret-na">資料不足</span>
                                }
                                else
                                {
                                    <span class="@(value > 0 ? "ret-up" : value < 0 ? "ret-down" : "")">@(value > 0 ? "+" : "")@value.Value.ToString("0.00")%</span>
                                }
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // 數值參數：標籤 + 窄輸入框
    private RenderFragment NumberParam(Models.Patterns.PatternParameter p, bool enabled) =>
        @<label class="param @(enabled ? "" : "disabled")">
            <span>@p.Label</span>
            <input type="number" class="dark-input" step="@Num(p.Step)" min="@Num(p.Min)" max="@Num(p.Max)"
                   value="@Num(Values.Get(p.Key))" disabled="@(!enabled)" @oninput="e => OnNumberInput(p, e)" />
        </label>;
}
